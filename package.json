{
  "name": "gameswarp-mcp",
  "version": "0.1.0",
  "description": "MCP server for investigating Steam games through what players actually write: reviews, review timelines and patch notes.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "steam",
    "game-reviews",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladMogwai/gameswarp-mcp.git"
  },
  "type": "module",
  "bin": {
    "gameswarp-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 6 && npm run db:migrate",
    "lint:lang": "node scripts/check-no-cyrillic.mjs",
    "acceptance": "npm run build && node scripts/acceptance.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run lint:lang && npm run typecheck && npm test && npm run build",
    "tick": "npm run build && node scripts/tick.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.23.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.5.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/VladMogwai/gameswarp-mcp#readme",
  "bugs": {
    "url": "https://github.com/VladMogwai/gameswarp-mcp/issues"
  }
}
