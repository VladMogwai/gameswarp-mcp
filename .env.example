# Copy to .env and fill in. Nothing here is committed.

# Hosted Postgres. Without it everything falls back to the local container on
# port 5433, which is what `docker compose up -d` starts.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Which model answers. Anything above this layer never names a provider.
#
# Local, for iterating and for eval runs where the volume would blow through a
# free tier's daily budget:
#   MODEL_PROVIDER=ollama
#   MODEL_NAME=gemma4-local
#
# Hosted, for anything on a schedule. GitHub Actions cannot reach a laptop, and
# a laptop should not be the compute for background work.
MODEL_PROVIDER=openai-compatible
MODEL_NAME=openai/gpt-oss-20b
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
